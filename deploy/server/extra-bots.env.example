# Settings of the «Совесть» bot for the shared n8n on the AdminVPS server.
# Copy to /opt/mila-tg-bot/deploy/server/extra-bots.env, fill in, then:
#   chmod 600 extra-bots.env && cd /opt/mila-tg-bot/deploy/server && docker compose up -d n8n
# No spaces around "=", no quotes.

# The bot's Code nodes read these settings via $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Token from @BotFather (the bot @my_sovest_bot).
TELEGRAM_BOT_TOKEN=
# Proxy to Telegram (the Netherlands server), without a trailing slash.
TELEGRAM_API_URL=https://PROXY-DOMAIN

# Calculator and documents on this server (DOMAIN = the n8n address, e.g. 137.22.149.182.sslip.io).
CALCULATOR_URL=https://DOMAIN/calc/
PD_POLICY_URL=https://DOMAIN/calc/privacy.html
PD_CONSENT_URL=https://DOMAIN/calc/consent.html
PD_MAILING_CONSENT_URL=https://DOMAIN/calc/mailing.html

# «Задать вопрос» button.
SPECIALIST_URL=https://t.me/poljka_uli
# Telegram IDs of people who may send broadcasts, comma-separated.
ADMIN_TELEGRAM_IDS=
