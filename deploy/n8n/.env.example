# Copy to .env and fill in:  cp .env.example .env && nano .env
# .env holds the bot token — never commit it.

# Subdomain for n8n itself (editor + Telegram webhooks), e.g. n8n.your-domain.ru
N8N_DOMAIN=n8n.your-domain.ru

# Random key that encrypts saved credentials. Generate once:  openssl rand -hex 32
# Keep it: losing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# Bot token from @BotFather (the same one goes into the Telegram credential in n8n).
TELEGRAM_BOT_TOKEN=

# Address of the calculator. The bot checks it before showing the button.
CALCULATOR_URL=https://your-domain.ru/

# Personal data documents shown in the welcome message.
PD_POLICY_URL=https://your-domain.ru/privacy
PD_CONSENT_URL=https://your-domain.ru/consent
# Consent to mailings: the link in the «Получать новости» message.
PD_MAILING_CONSENT_URL=https://your-domain.ru/mailing

# "Задать вопрос" button: the specialist's Telegram account.
SPECIALIST_URL=https://t.me/specialist_username

# Telegram IDs of people who may send broadcasts (comma-separated). They get the «📣 Рассылка» button.
# Your ID is in the n8n Data table bot_users (column telegram_id) after you press /start.
ADMIN_TELEGRAM_IDS=
