      "position": [
        520,
        -100
      ],
      "parameters": {
        "jsCode": "// Deleted rows come out of the previous node; an error item has no telegram_id.\nreturn $input.all().filter((i) => i.json.telegram_id).map((i) => ({ json: { telegram_id: String(i.json.telegram_id) } }));"
      }
    },
