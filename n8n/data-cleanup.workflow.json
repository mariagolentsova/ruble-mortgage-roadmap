        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "bot_users"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "updatedAt",
              "condition": "lt",
              "keyValue": "={{ $now.minus({ years: 3 }).toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
